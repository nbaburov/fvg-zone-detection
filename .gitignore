# Override global gitignore — track CLAUDE.md and .nb-suite for this project
!CLAUDE.md
!.nb-suite/
!.nb-suite/**

# Standard Python ignores
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/
*.egg-info/

# Data + checkpoints + study DBs are tracked (small enough, frozen artefacts)
# Total ~65MB across raw + processed + checkpoints — under GitHub 100MB/file limit.
# Re-evaluate if a single file approaches 100MB (use git-lfs).

# Notebook checkpoints
.ipynb_checkpoints/

# Logs
logs/
*.log

# Test predictions & analysis artifacts (ephemeral model outputs)
data/processed/test_predictions*.npz
reports/

# Env vars (real)
.env
.env.local

# OS
.DS_Store
reports/
